{
  "name": "Social Scraper Hub",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "postCreateCommand": "npm install -g pnpm && pnpm install",
  "forwardPorts": [
    8081,
    19000,
    19001,
    19002
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}

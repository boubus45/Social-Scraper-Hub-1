# Backend configuration template — copy to .env and fill in real values.
# .env is gitignored; this file is not, so never put secrets in it.

# HTTP port the API listens on.
PORT=3000

# Log verbosity (trace|debug|info|warn|error|fatal).
LOG_LEVEL=info

# ─── Bright Data ────────────────────────────────────────────────────────────
# API key from https://brightdata.com/cp/setting/users (Authorization: Bearer).
BRIGHTDATA_API_TOKEN=

# Public URL Bright Data should POST results to. Must end in
# /api/webhooks/brightdata. Leave unset to collect by polling only — the
# hourly loop and the collect endpoint wait for Bright Data snapshots
# themselves, so deliveries are an optimisation, not a requirement.
BRIGHTDATA_WEBHOOK_URL=

# Shared secret Bright Data must present to reach the webhook. Accepted as
# `Authorization: Bearer <secret>`, an `x-webhook-secret` header, or a
# `secret=<…>` query parameter on the delivery URL. Generate with:
#   openssl rand -hex 24
# Leave empty to accept deliveries without authentication.
BRIGHTDATA_WEBHOOK_SECRET=

# ─── Persistence ─────────────────────────────────────────────────────────────
# Postgres connection string. When set, sources/subscriptions/posts are stored
# in these tables (create them with `pnpm run push` in lib/db):
#   social_sources, subscriptions, posts
# Leave unset to persist to a JSON snapshot instead (see next variable).
DATABASE_URL=

# Where the JSON snapshot goes when DATABASE_URL is unset. Relative paths are
# resolved from the working directory (artifacts/api-server when started there).
BRIGHTDATA_STATE_FILE=.brightdata-state.json

# ─── Apify (Reddit feed, Instagram/Facebook monitors) ──────────────────────
APIFY_API_TOKEN=
APIFY_INSTAGRAM_ACTOR_ID=
APIFY_FACEBOOK_MONITOR_ACTOR_ID=
APIFY_SOCIAL_MONITOR_ACTOR_ID=
APIFY_WEBHOOK_SECRET=

# ─── OAuth (optional — only needed for built-in posting) ───────────────────
# Reddit
REDDIT_OAUTH_CLIENT_ID=
REDDIT_OAUTH_CLIENT_SECRET=
REDDIT_OAUTH_REDIRECT_URI=

# X
X_OAUTH_CLIENT_ID=
X_OAUTH_REDIRECT_URI=

# LinkedIn
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_REDIRECT_URI=

# Facebook
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=

# Instagram
INSTAGRAM_OAUTH_CLIENT_ID=
INSTAGRAM_OAUTH_CLIENT_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=
